# Rendered by the nginx image entrypoint (envsubst on /etc/nginx/templates/*.template) into conf.d/default.conf.
# Variables: API_UPSTREAM (default http://api:8080), CSP_CONNECT_EXTRA (extra connect-src origins, e.g. the public
# S3 URL when artifact downloads are presigned redirects to another origin).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers on every response (also errors). A location that adds its own add_header would drop these.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${CSP_CONNECT_EXTRA}; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    server_tokens off;
    client_max_body_size 64m;   # design bundles: the API caps them at 50 MiB uncompressed

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, same origin as the app (no CORS). SSE streams must not be buffered or cut short.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 5m;
    }

    # Hashed build output: cache for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    # Single-page app: unknown paths serve index.html; the shell itself is never cached.
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
