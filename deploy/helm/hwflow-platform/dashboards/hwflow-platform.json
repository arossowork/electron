  {
   "id": 13,
   "type": "bargauge",
   "title": "Failed attempts by error class (last 6 h)",
   "description": "ToolMissing, WorkerLost (OOM), ToolCrashed, StoreUnavailable, DesignInvalid, ...",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 8,
    "y": 27,
    "w": 8,
