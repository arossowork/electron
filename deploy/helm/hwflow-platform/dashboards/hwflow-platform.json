    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (error_class, stage) (increase(hwp_activities_failed_total[6h]))",
     "legendFormat": "{{error_class}} {{stage}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ]
