# Copy to deploy/compose/.env and change the values. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
HWFLOW_DB_PASSWORD=change-me-hwflow
HWFLOW_APP_DB_PASSWORD=change-me-app
TEMPORAL_DB_PASSWORD=change-me-temporal
S3_ACCESS_KEY=hwflowaccess
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=hwflow-artifacts

# hwplatform BYOK (services/platform): generate with openssl rand -base64 32 and export as HWPLATFORM_MASTER_KEY
