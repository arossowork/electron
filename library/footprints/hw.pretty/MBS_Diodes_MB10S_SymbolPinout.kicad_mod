(footprint "MBS_Diodes_MB10S_SymbolPinout" (version 20211014) (generator pcbnew)
  (layer "F.Cu")
  (tedit 0)
  (descr "Diodes Inc MBS bridge (MB10S, DS39045 Rev 3-2 p.4): suggested pad layout C 2.50, X 1.00, X1 3.50, Y 2.15, Y1 7.50 (pads 1.0 x 2.15, pair pitch 2.5, overall 7.5). Pad NUMBERS follow the KiCad symbol Diode_Bridge:MB4S (1,2 = AC, 3 = +, 4 = -), NOT the maker pin numbers: maker pin 4 = pad 1 (AC), maker pin 2 = pad 2 (AC), maker pin 1 (+) = pad 3, maker pin 3 (-) = pad 4. Rotated 90 deg from the datasheet view; + and - pads on the right, AC pads on the left. Pad width X narrowed from 1.00 to 0.70 = lead width b max (DS39045 Rev 3-2 p.4: b 0.50-0.70, e 2.30-2.70, L 0.60-1.10) so the gap between the pads of a pair is 1.80 mm (1.8 mm creepage of mains_dc and buck_sw, timed-bathroom-vent); a 1.85 mm gap (+0.05 etch) would need X 0.65 < b max and is not drawn. The leads themselves are 2.5 - 0.6 = 1.90 apart nominal and 2.30 - 0.70 = 1.60 at the worst tolerance.")
  (tags "bridge MBS MB10S SMD")
  (attr smd)
  (fp_text reference "REF**" (at 0 -3.9) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
